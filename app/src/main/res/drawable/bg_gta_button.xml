<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#88FFFFFF">
    <item>
        <layer-list>
            <!-- Bayangan bawah + border komik tebal -->
            <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FF0B0906" />
                    <corners android:radius="15dp" />
                    <stroke android:width="3dp" android:color="#FFD3AA69" />
                </shape>
            </item>
            <!-- Gradient oranye vintage -->
            <item android:bottom="3dp" android:left="3dp" android:right="3dp" android:top="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:startColor="#FFFFB348" android:centerColor="#FFFF8C2F" android:endColor="#FFFF7810" />
                    <corners android:radius="13dp" />
                    <stroke android:width="1dp" android:color="#FFFFD28A" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
