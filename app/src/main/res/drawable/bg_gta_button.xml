<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#88FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FF130D08" />
                    <corners android:radius="14dp" />
                    <stroke android:width="2dp" android:color="#FF8A6D3B" />
                </shape>
            </item>
            <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="90" android:startColor="#FFFFB348" android:centerColor="#FFFF8C2F" android:endColor="#FFFF9D24" />
                    <corners android:radius="12dp" />
                    <stroke android:width="1dp" android:color="#FFFFD28A" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
