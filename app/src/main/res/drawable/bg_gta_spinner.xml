<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#FF252729" android:endColor="#FF171819" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#77D69643" />
        </shape>
    </item>
    <item
        android:width="10dp"
        android:height="10dp"
        android:gravity="end|center_vertical"
        android:right="12dp">
        <rotate android:fromDegrees="45" android:toDegrees="45">
            <shape android:shape="rectangle">
                <size android:width="7dp" android:height="7dp" />
                <solid android:color="#FFFFB33C" />
            </shape>
        </rotate>
    </item>
</layer-list>
