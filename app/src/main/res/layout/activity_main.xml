<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gta_art_screen"
    android:fillViewport="true"
    android:overScrollMode="never">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="14dp"
        android:paddingEnd="24dp"
        android:paddingBottom="26dp">

        <!-- CJ karakter di pojok kanan atas, mirip collage komik GTA SA -->
        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/cj_character" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="210dp"
                android:layout_height="184dp"
                android:layout_marginBottom="-2dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_gta" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="14dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_pricedown" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="17dp"
            android:background="#99F4B04B" />

        <ImageView
            android:layout_width="210dp"
            android:layout_height="42dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_sonybae" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.05"
            android:text="SCREEN CAPTURE  /  INTERNAL AUDIO"
            android:textColor="#FFFFB36A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gta_panel"
            android:elevation="4dp"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingTop="14dp"
            android:paddingEnd="15dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.035"
                android:text="▰  RECORDING SETUP"
                android:textColor="#FFFFB84A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="RESOLUTION"
                android:textColor="#FFFFC58B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerResolution"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_gta_spinner"
                android:dropDownWidth="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="32dp"
                android:popupBackground="#FF222326" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="VIDEO BITRATE"
                android:textColor="#FFFFC58B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerBitrate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_gta_spinner"
                android:dropDownWidth="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="32dp"
                android:popupBackground="#FF222326" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="FRAME RATE"
                android:textColor="#FFFFC58B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerFps"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_gta_spinner"
                android:dropDownWidth="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="32dp"
                android:popupBackground="#FF222326" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:layout_marginBottom="13dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="9dp"
                android:background="#FF74D687" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="2dp"
                android:text="AUDIO INTERNAL GAME / SISTEM DIREKAM — MIKROFON TIDAK DIPAKAI"
                android:textColor="#FF8BCB8E"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStartRecord"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_gta_button"
            android:backgroundTint="@null"
            android:elevation="8dp"
            android:fontFamily="@font/pricedown"
            android:letterSpacing="0.04"
            android:text="MULAI REKAM"
            android:textAllCaps="false"
            android:textColor="#FF17100A"
            android:textSize="25sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14"
            android:text="LOS SANTOS  •  BUILT FOR ITEL P55 5G"
            android:textColor="#FF77716A"
            android:textSize="9sp" />

        </LinearLayout>
    </FrameLayout>
</ScrollView>
