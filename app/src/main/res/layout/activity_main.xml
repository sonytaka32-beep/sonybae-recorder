<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gta_screen"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="22dp"
        android:paddingEnd="24dp"
        android:paddingBottom="26dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pricedown"
                android:includeFontPadding="false"
                android:text="grand theft auto"
                android:textColor="#FF9E5C28"
                android:textSize="35sp"
                android:textStyle="bold"
                android:translationX="1dp"
                android:translationY="3dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pricedown"
                android:includeFontPadding="false"
                android:shadowColor="#CCFFB74A"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="11"
                android:text="grand theft auto"
                android:textColor="#FFFFFFFF"
                android:textSize="35sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="19dp"
            android:fontFamily="@font/diploma"
            android:includeFontPadding="false"
            android:shadowColor="#FFFF9B35"
            android:shadowDx="2"
            android:shadowDy="3"
            android:shadowRadius="5"
            android:text="San Andreas"
            android:textColor="#FFFFCF77"
            android:textSize="32sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="17dp"
            android:background="#99F4B04B" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pricedown"
                android:includeFontPadding="false"
                android:letterSpacing="0.03"
                android:text="SONYBAE RECORDER"
                android:textColor="#FF79614B"
                android:textSize="31sp"
                android:textStyle="bold"
                android:translationX="1dp"
                android:translationY="3dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pricedown"
                android:includeFontPadding="false"
                android:letterSpacing="0.03"
                android:shadowColor="#CCFFFFFF"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="12"
                android:text="SONYBAE RECORDER"
                android:textColor="#FFFFFFFF"
                android:textSize="31sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="22dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.20"
            android:text="SCREEN CAPTURE  /  INTERNAL AUDIO"
            android:textColor="#FFC48B4B"
            android:textSize="9sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gta_panel"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="17dp"
            android:paddingTop="16dp"
            android:paddingEnd="17dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.035"
                android:text="▰  RECORDING SETUP"
                android:textColor="#FFFFB84A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="RESOLUTION"
                android:textColor="#FFB8B5B0"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerResolution"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_gta_spinner"
                android:dropDownWidth="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="32dp"
                android:popupBackground="#FF222326" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="VIDEO BITRATE"
                android:textColor="#FFB8B5B0"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerBitrate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_gta_spinner"
                android:dropDownWidth="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="32dp"
                android:popupBackground="#FF222326" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="FRAME RATE"
                android:textColor="#FFB8B5B0"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerFps"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_gta_spinner"
                android:dropDownWidth="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="32dp"
                android:popupBackground="#FF222326" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:layout_marginBottom="13dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="9dp"
                android:background="#FF74D687" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="2dp"
                android:text="AUDIO INTERNAL GAME / SISTEM DIREKAM — MIKROFON TIDAK DIPAKAI"
                android:textColor="#FF8BCB8E"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStartRecord"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_gta_button"
            android:backgroundTint="@null"
            android:elevation="8dp"
            android:fontFamily="@font/pricedown"
            android:letterSpacing="0.04"
            android:text="MULAI REKAM"
            android:textAllCaps="false"
            android:textColor="#FF17100A"
            android:textSize="25sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14"
            android:text="LOS SANTOS  •  BUILT FOR ITEL P55 5G"
            android:textColor="#FF77716A"
            android:textSize="9sp" />

    </LinearLayout>
</ScrollView>
