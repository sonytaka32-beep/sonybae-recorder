<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SONYBAE"
        android:textColor="#FF9800"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SCREEN RECORDER HD"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:letterSpacing="0.1"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="48dp"
        android:background="#1E1E1E"
        android:padding="16dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ PENGATURAN OTOMATIS:"
            android:textColor="#AAAAAA"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="• Resolusi: Mengikuti Layar Asli (No Crop)\n• Frame Rate: 60 FPS (Super Smooth)\n• Bitrate: 20 Mbps (Anti Pecah)\n• Penyimpanan: Galeri (Folder SONYBAE)"
            android:textColor="#888888"
            android:lineSpacingExtra="4dp"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnStartRecord"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:backgroundTint="#FF9800"
        android:elevation="8dp"
        android:text="MULAI REKAM"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold"/>
</LinearLayout>