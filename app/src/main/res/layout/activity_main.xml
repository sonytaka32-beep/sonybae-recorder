<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gta_art_screen"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <!-- Colorful comic-strip header, with CJ as a small corner accent. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:background="@drawable/bg_gta_comic_frame"
            android:padding="3dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/gta_comic_header" />

            <ImageView
                android:layout_width="82dp"
                android:layout_height="96dp"
                android:layout_gravity="end|bottom"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/cj_character" />
        </FrameLayout>

        <!-- GTA SA is the hero title, matching the supplied poster composition. -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="126dp"
            android:layout_marginTop="2dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_gta_wide" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="-3dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_sonybaeproject" />

        <ImageView
            android:layout_width="158dp"
            android:layout_height="22dp"
            android:layout_marginTop="-1dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/logo_sonybae" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="sans-serif-condensed"
            android:letterSpacing="0.12"
            android:text="SCREEN CAPTURE  /  INTERNAL AUDIO"
            android:textColor="#FFFFC07B"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Compact, legible settings panel. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_gta_panel"
            android:elevation="4dp"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="11dp"
            android:paddingEnd="12dp"
            android:paddingBottom="11dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-condensed"
                android:letterSpacing="0.035"
                android:text="▰  RECORDING SETUP"
                android:textColor="#FFFFB84A"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="RESOLUTION"
                android:textColor="#FFFFC58B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerResolution"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_gta_spinner"
                android:dropDownWidth="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="32dp"
                android:popupBackground="#FF222326" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="VIDEO BITRATE"
                android:textColor="#FFFFC58B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerBitrate"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_gta_spinner"
                android:dropDownWidth="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="32dp"
                android:popupBackground="#FF222326" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:fontFamily="sans-serif-medium"
                android:text="FRAME RATE"
                android:textColor="#FFFFC58B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerFps"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:background="@drawable/bg_gta_spinner"
                android:dropDownWidth="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="32dp"
                android:popupBackground="#FF222326" />
        </LinearLayout>

        <!-- Explicitly communicate that only internal audio is captured. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="8dp"
                android:background="#FF74D687" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="1dp"
                android:text="AUDIO INTERNAL GAME / SISTEM DIREKAM — MIKROFON TIDAK DIPAKAI"
                android:textColor="#FF9AD39B"
                android:textSize="10sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStartRecord"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_gta_button"
            android:backgroundTint="@null"
            android:elevation="3dp"
            android:fontFamily="@font/pricedown"
            android:letterSpacing="0.04"
            android:text="MULAI REKAM"
            android:textAllCaps="false"
            android:textColor="#FF17100A"
            android:textSize="24sp" />


    </LinearLayout>
</ScrollView>
